# UniGuide Environment Configuration
# Copy this file to .env and fill in the values

# Database connection (SQLite for local dev, or Neon PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@endpoint.neon.tech/dbname?sslmode=require"

# Base URL of the application
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# NextAuth URL (must match your deployment URL)
NEXTAUTH_URL="http://localhost:3000"

# NextAuth Secret (Must be 32+ random characters)
# Generate one using: openssl rand -base64 32
NEXTAUTH_SECRET=""

# Anthropic API Key for Tutoring and Chatbot AI Features (Starts with sk-ant-)
ANTHROPIC_API_KEY=""
